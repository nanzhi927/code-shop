# 服务端口（生产常见 8080；对外访问用 服务器IP:PORT）
PORT=8080

# 站点对外根地址：sitemap.xml 与 robots.txt 里输出的地址
# 不填也能用：程序会按请求头（Nginx 反代）自动推导真实域名
# 若前面挂了 Nginx 或域名，建议显式填，例如 https://your-domain.com
SITE_URL=http://你的服务器IP:端口

# MySQL（与 Node 同机时用 127.0.0.1）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=请改成强密码
DB_NAME=code_shop

# JWT（生产务必改成随机长字符串）
JWT_SECRET=请改成随机长字符串
JWT_EXPIRES=7d

# 免费开题 AI（OpenAI 兼容协议；不配 Key 则使用本地 mock）
# DeepSeek V4.1 Flash 官方 model 名为 deepseek-flash
# AI_PROVIDER=mock
# AI_BASE_URL=https://api.deepseek.com
# AI_API_KEY=
# AI_MODEL=deepseek-flash
# AI_TIMEOUT_MS=120000
